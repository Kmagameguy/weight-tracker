<div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
  <%= form_with url: report_path, method: :get do |f| %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="flex flex-col gap-1">
        <%= f.label :start_date, "From", class: "text-xs text-slate-400" %>
        <%= f.date_field :start_date, value: report.start_date, max: Date.current,
              class: "text-sm rounded-lg border border-slate-200 px-3 py-2 text-slate-700
                      focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= f.label :end_date, "To", class: "text-xs text-slate-400" %>
        <%= f.date_field :end_date, value: report.end_date, max: Date.current,
              class: "text-sm rounded-lg border border-slate-200 px-3 py-2 text-slate-700
                      focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
      </div>

      <%= f.submit "Update report",
            class: "text-sm font-medium bg-emerald-500 hover:bg-emerald-600
                    text-white px-4 py-2 rounded-lg transition-colors cursor-pointer" %>
    </div>

    <% if report.user.calorie_tracking_enabled? %>
      <label class="flex items-center gap-2 mt-4 text-sm text-slate-600 cursor-pointer">
        <%= f.check_box :include_calories, { checked: report.include_calories? }, "1", "0" %>
          Include calorie information
      </label>
    <% end %>

    <% if report.user.weight_tracking_enabled? %>
      <label class="flex items-center gap-2 mt-4 text-sm text-slate-600 cursor-pointer">
        <%= f.check_box :include_weights, { checked: report.include_weights? }, "1", "0" %>
          Include weight information
      </label>
    <% end %>

    <% if report.user.blood_pressure_tracking_enabled? %>
      <label class="flex items-center gap-2 mt-4 text-sm text-slate-600 cursor-pointer">
        <%= f.check_box :include_blood_pressure_readings, { checked: report.include_blood_pressure_readings? }, "1", "0" %>
          Include blood pressure information
      </label>
    <% end %>

    <% if report.user.tagging_enabled? %>
      <label class="flex items-center gap-2 mt-4 text-sm text-slate-600 cursor-pointer">
        <%= f.check_box :include_tags, { checked: report.include_tags? }, "1", "0" %>
          Include daily tag information
      </label>
    <% end %>

    <% if report.user.journaling_enabled? %>
      <label class="flex items-center gap-2 mt-4 text-sm text-slate-600 cursor-pointer">
        <%= f.check_box :include_journal, { checked: report.include_journal? }, "1", "0" %>
          Include journal notes
      </label>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-4 border-t border-slate-400">
    <div class="flex flex-wrap items-center gap-3 text-sm">
      <%
        [
          [ "Last 30 days", 30 ],
          [ "Last 90 days", 90 ],
          [ "Last 6 months", 182 ],
          [ "Last year", 365 ]
        ].each do |label, days| %>
        <%= link_to label,
              report_path(start_date: Date.current - (days - 1),
                          end_date: Date.current,
                          inclde_journal: (report.include_journal? ? "1" : nil)),
                class: "text-slate-400 hover:text-slate-700 transition-colors" %>
      <% end %>
    </div>

    <button type="button"
      data-controller="print"
      data-action="click->print#print"
      class="text-sm font-medium border border-slate-200 text-slate-600 hover:bg-slate-50
             px-4 py-2 rounded-lg transition-colors cursor-pointer">
      Print or save as PDF
    </button>
  </div>
</div>
