<%= form_with model: tag, url: url do |f| %>
  <div class="flex flex-col gap-3">
    <% if tag.errors.any? %>
      <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2">
        <p class="text-xs font-medium text-red-700 mb-1">
          Please fix the following:
        </p>

        <ul class="list-disc pl-4 space-y-0.5 text-xs text-red-600">
          <% tag.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-2">
      <%= f.text_field :name,
            required: true,
            maxlength: ::Tag::MAX_NAME_LENGTH,
            autocomplete: "off",
            placeholder: "e.g. Headache",
            class: "min-w-0 flex-1 text-sm rounded-lg border border-slate-200
                    bg-white px-3 py-2 text-slate-700 placeholder-slate-300
                    focus:outline-none focus:ring-2 focus:ring-emerald-400
                    focus:border-transparent transition" %>

      <%= f.submit "Save",
            class: "shrink-0 text-sm font-medium bg-emerald-500 hover:bg-emerald-600
                    text-white px-4 py-2 rounded-lg transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>
