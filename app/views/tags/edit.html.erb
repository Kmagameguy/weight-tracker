<%= turbo_frame_tag @tag, class: "block w-full min-w-0" do %>
  <div class="w-full rounded-lg border border-slate-100 p-4">
    <%= render "form", tag: @tag, url: tag_path(@tag) %>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <%= link_to "Cancel", profile_path,
        class: "text-sm text-slate-400 hover:text-slate-600" %>

      <%= button_to "Delete",
            tag_path(@tag),
            method: :delete,
            data: { turbo_confirm: "Remove \"#{@tag.name}\"? All entries will be deleted too." },
            class: "text-sm font-medium text-red-600 hover:text-red-700
                    rounded-lg border border-red-200 bg-white
                    px-3 py-2 transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>
