<div class="max-w-xl mx-auto px-2 py-4 flex flex-col gap-5">
  <div class="bg-white shadow-sm border border-slate-200 rounded-lg p-4">
    <h2 class="font-semibold text-slate-800 mb-1">Doctor visit report</h2>

    <p class="text-xs text-slate-400 mb-4">
      A printable summary of your calories, weight, blood pressure, tags, and (optionally) journal notes for any date range.
    </p>

    <%= link_to "Create a report", report_path,
          class: "inline-block text-sm font-medium bg-emerald-500 hover:bg-emerald-600
                  text-white px-4 py-2 rounded-lg transition-colors" %>
  </div>
</div>
