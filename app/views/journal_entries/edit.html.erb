<div class="min-h-screen bg-slate-50 flex items-start justify-center pt-24 px-4">
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 w-full max-w-lg">
    <%= turbo_frame_tag "journal_entry" do %>
      <h1 class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-1">
        Edit journal entry
      </h1>

      <p class="text-sm text-slate-500 mb-6">
        <%= @journal_entry.date.strftime("%B %-d, %Y") %>
      </p>

      <%= render "journal_entries/form", journal_entry: @journal_entry %>

      <div class="mt-4">
        <%= link_to "Cancel", day_path_for(@journal_entry),
              class: "text-sm textslate-400 hover:text-slate-600 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
